<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageId>BitNetSharp.Core</PackageId>
    <Description>Paper-aligned BitNet b1.58 transformer runtime for .NET.</Description>
    <!--
      Core serves both the coordinator (full CLR, reflection-based checkpoint + GGUF
      + training serialization) AND transitively the AOT Runtime slice. The reflection
      JSON sites (BitNetPaperCheckpoint, BitNetPaperGguf, TraditionalLocalCheckpoint,
      ModelScaleProfile, DataGenGenerator, BitNetDataLoader) are NOT called from the
      AOT inference path (InProcessBitNetModel only touches BitNetPaperModel ctor +
      FlatParameterPack). Suppress the analyzer errors here rather than spraying
      [RequiresUnreferencedCode]/[RequiresDynamicCode] up every call chain. Follow-up
      TODO: migrate to System.Text.Json source generators so the AOT analyzer can
      verify the Runtime slice independently.
    -->
    <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data/WikiText2/wiki.*.tokens" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Condition="Exists('Data/Models/bitnet-b1.58-default.gguf')">
    <Content Include="Data/Models/bitnet-b1.58-default.gguf"
             Pack="true"
             PackagePath="contentFiles/any/any/Models/"
             CopyToOutputDirectory="PreserveNewest"
             PackageCopyToOutput="true" />
  </ItemGroup>

</Project>
