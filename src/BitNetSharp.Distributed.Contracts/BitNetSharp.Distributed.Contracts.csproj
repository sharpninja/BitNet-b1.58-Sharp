<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RootNamespace>BitNetSharp.Distributed.Contracts</RootNamespace>
    <AssemblyName>BitNetSharp.Distributed.Contracts</AssemblyName>
    <Description>Wire-format DTOs shared between the BitNet distributed training coordinator and its workers.</Description>
    <!-- See BitNetSharp.Core.csproj for rationale: WordLevelTokenizer tokenizer-file I/O is
         coordinator-side (full CLR), not called from the AOT inference path. -->
    <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
  </PropertyGroup>

</Project>
