<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BitNetSharp.Benchmarks.Maui.ChatPage"
             Title="TruckMate intent chat">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="TruckMate SLM intent classifier"
                   Style="{StaticResource Headline}" />

            <Label Text="Loads truckmate-small.tmv1 (~17 MiB, 4.4M params) embedded in the APK as MauiAsset. First launch extracts to AppDataDirectory (sub-second); subsequent launches reuse the cached file. Streams per-token forward_ms / select_ms / decode_ms while the model classifies a TruckMate utterance."
                   Style="{StaticResource SubHeadline}" />

            <HorizontalStackLayout Spacing="12">
                <Label Text="KV:" VerticalOptions="Center" />
                <Picker x:Name="KvPicker" WidthRequest="160" SelectedIndex="0">
                    <Picker.Items>
                        <x:String>Fp32</x:String>
                        <x:String>Int8</x:String>
                    </Picker.Items>
                </Picker>
                <Label Text="Max tokens:" VerticalOptions="Center" />
                <Entry x:Name="MaxTokensEntry"
                       Text="32"
                       Keyboard="Numeric"
                       WidthRequest="80" />
            </HorizontalStackLayout>

            <Button x:Name="LoadBtn"
                    Text="Load model"
                    Clicked="OnLoadClicked" />

            <Entry x:Name="PromptEntry"
                   Placeholder="Enter TruckMate utterance..."
                   Text="[USER] take me to the flying j in dallas [INTENT]" />

            <Label Text="Sample prompts: '[USER] take me to the flying j in dallas [INTENT]', '[USER] check my hours [INTENT]', '[USER] avoid tolls [INTENT]', '[USER] what's my eta [INTENT]'. The model will continue the [INTENT] {...} JSON. Quality depends on training depth (smoke build = 100-1000 examples; production = 50K)."
                   FontSize="10"
                   FontAttributes="Italic" />

            <Button x:Name="SendBtn"
                    Text="Send"
                    Clicked="OnSendClicked"
                    IsEnabled="False" />

            <Label x:Name="StatusLabel"
                   Text="Idle."
                   FontAttributes="Italic" />

            <ProgressBar x:Name="LoadProgress"
                         Progress="0"
                         IsVisible="False"
                         HeightRequest="6" />

            <Label x:Name="ProgressLabel"
                   Text=""
                   FontSize="11"
                   FontAttributes="Italic" />

            <Editor x:Name="OutputEditor"
                    HeightRequest="540"
                    IsReadOnly="True"
                    FontFamily="Monospace"
                    FontSize="11"
                    AutoSize="Disabled"
                    Text="" />

            <Button x:Name="CopyBtn"
                    Text="Copy results to clipboard"
                    Clicked="OnCopyClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
