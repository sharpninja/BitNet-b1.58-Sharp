<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BitNetSharp.Benchmarks.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BitNetSharp.Benchmarks.Maui"
    Title="BitNetSharp.Benchmarks.Maui">

    <TabBar>
        <ShellContent
            Title="KV Bench"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="Chat"
            ContentTemplate="{DataTemplate local:ChatPage}"
            Route="ChatPage" />
        <ShellContent
            Title="Intent"
            ContentTemplate="{DataTemplate local:IntentBenchPage}"
            Route="IntentBenchPage" />
    </TabBar>

</Shell>
